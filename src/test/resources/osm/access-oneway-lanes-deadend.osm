<?xml version="1.0" encoding="UTF-8"?>
<osm version="0.6" generator="matsim-models-test">
  <!-- Rail hub: a junction (node 2) with two one-way terminal stubs (nodes 3 and 4) and one
       bidirectional feeder (node 1). Rail is not a routable mode, so network cleanup keeps the
       dead-end stubs; the two terminal links have no outgoing links at their to-node and must be
       skipped by the lane builder with a lane-no-outgoing warning. -->
  <node id="1" lat="0.000000" lon="0.000000" />
  <node id="2" lat="0.000000" lon="0.001000" />
  <node id="3" lat="0.001000" lon="0.001000" />
  <node id="4" lat="-0.001000" lon="0.001000" />
  <way id="40">
    <nd ref="1" /><nd ref="2" />
    <tag k="railway" v="rail" />
    <tag k="lanes" v="1" />
  </way>
  <way id="41">
    <nd ref="2" /><nd ref="3" />
    <tag k="railway" v="rail" />
    <tag k="oneway" v="yes" />
    <tag k="lanes" v="1" />
  </way>
  <way id="42">
    <nd ref="2" /><nd ref="4" />
    <tag k="railway" v="rail" />
    <tag k="oneway" v="yes" />
    <tag k="lanes" v="1" />
  </way>
</osm>
